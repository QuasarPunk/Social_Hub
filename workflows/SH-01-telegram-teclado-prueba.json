    {
      "id": "ca234caf-5187-43d6-b254-09543e05c75c",
      "name": "Preparar botones de proyectos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2352,
        -32
      ],
      "parameters": {
        "jsCode": "\nconst record = $input.first().json;\n\nif (\n  record.status !== \"PENDING_CLASSIFICATION\" ||\n  !record.clarification?.required\n) {\n  throw new Error(\"El contenido no requiere aclaracion\");\n}\n\nconst options = record.clarification.options ?? [];\n\nif (!options.length) {\n  throw new Error(\"No hay proyectos disponibles\");\n}\n\n// Telegram admite callback_data de hasta 64 bytes.\n// Usamos un identificador corto de contenido y proyecto.\nconst buttons = options.map(project => {\n  const callbackData = `sh:${record.content_id}:${project.project_id}`;\n  const byteLength = Buffer.byteLength(callbackData, \"utf8\");\n  if (byteLength < 1 || byteLength > 64) {\n    throw new Error(\"callback_data debe ocupar entre 1 y 64 bytes UTF-8\");\n  }\n  return [{ text: project.name, callback_data: callbackData }];\n});\n\nreturn [{\n  json: {\n    content_id: record.content_id,\n    chat_id: record.chat_id,\n    message:\n      \"📂 SOCIAL HUB — Seleccionar proyecto\\n\\n\" +\n      \"No pude identificar con certeza el destinatario \" +\n      \"del contenido.\\n\\n\" +\n      \"Selecciona el proyecto correspondiente:\",\n    reply_markup: {\n      inline_keyboard: buttons\n    }\n  }\n}];\n"
      }
    },
    {
      "id": "0285a287-9035-4f50-a9c4-96ba71fe19e9",
      "name": "Enviar seleccion de proyecto",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        2592,
        -32
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $json.chat_id }}",
        "text": "={{ $json.message }}",
        "replyMarkup": "inlineKeyboard",
        "inlineKeyboard": "={{ ({\n  rows: $json.reply_markup.inline_keyboard.map(buttons => ({\n    row: {\n      buttons: buttons.map(button => ({\n        text: button.text,\n        additionalFields: { callback_data: button.callback_data }\n      }))\n    }\n  }))\n}) }}",
        "additionalFields": {}
      }
    },
