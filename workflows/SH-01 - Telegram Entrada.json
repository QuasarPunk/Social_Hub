    {
      "parameters": {
        "jsCode": "\nconst content = {\n  ...$('Normalizar mensaje').first().json\n};\n\n// Actualizar la ubicación de la fotografía.\nif (content.type === \"photo\") {\n  content.media_path =\n    `incoming/${content.content_id}.jpg`;\n}\n\n// Registrar el momento del almacenamiento.\ncontent.stored_at = new Date().toISOString();\ncontent.status = \"RECEIVED\";\n\nreturn [{ json: content }];\n"
      },
