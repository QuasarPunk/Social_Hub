    {
      "parameters": {
        "jsCode": "\nconst update = $input.first().json;\nconst message = update.message;\n\n// Identificar el tipo de contenido.\nconst hasPhoto = Array.isArray(message.photo)\n  && message.photo.length > 0;\n\n// Seleccionar la fotografía de mayor tamaño.\nconst photo = hasPhoto\n  ? message.photo[message.photo.length - 1]\n  : null;\n\nconst type = hasPhoto\n  ? \"photo\"\n  : message.text ? \"text\" : \"unsupported\";\n\n// Crear el registro de Social Hub.\nconst content = {\n  content_id: `tg-${update.update_id}`,\n  source: \"telegram\",\n  type: type,\n\n  chat_id: message.chat.id,\n  message_id: message.message_id,\n\n  instruction: message.caption || message.text || \"\",\n\n  project: null,\n\n  file_id: photo ? photo.file_id : null,\n  media_path: null,\n\n  received_at: new Date(\n    message.date * 1000\n  ).toISOString(),\n\n  status: type === \"unsupported\"\n    ? \"UNSUPPORTED\"\n    : \"RECEIVED\"\n};\n\nreturn [{ json: content }];\n"
      },
