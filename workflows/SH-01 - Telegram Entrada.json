    {
      "parameters": {
        "jsCode": "\nconst record = $input.first().json;\n\nif (\n  record.status !== \"PENDING_CLASSIFICATION\" ||\n  !record.clarification?.required\n) {\n  throw new Error(\"El contenido no requiere aclaracion\");\n}\n\nconst options = record.clarification.options ?? [];\n\nif (!options.length) {\n  throw new Error(\"No hay proyectos disponibles\");\n}\n\n// Telegram admite callback_data de hasta 64 bytes.\n// Usamos un identificador corto de contenido y proyecto.\nconst buttons = options.map(project => [{\n  text: project.name,\n  callback_data: `sh:${record.content_id}:${project.project_id}`\n}]);\n\nreturn [{\n  json: {\n    content_id: record.content_id,\n    chat_id: record.chat_id,\n    message:\n      \"📂 SOCIAL HUB — Seleccionar proyecto\\n\\n\" +\n      \"No pude identificar con certeza el destinatario \" +\n      \"del contenido.\\n\\n\" +\n      \"Selecciona el proyecto correspondiente:\",\n    reply_markup: {\n      inline_keyboard: buttons\n    }\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
