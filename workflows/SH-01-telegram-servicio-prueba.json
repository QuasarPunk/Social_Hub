        "jsonOutput": "{\n  \"content_id\": \"tg-1000\",\n  \"chat_id\": 123456789,\n  \"status\": \"PENDING_CLASSIFICATION\",\n  \"clarification\": {\n    \"required\": true,\n    \"options\": [\n      {\n        \"project_id\": \"bitacora\",\n        \"name\": \"Bitácora\"\n      },\n      {\n        \"project_id\": \"lamat\",\n        \"name\": \"Ecoaldea Lamat\"\n      },\n      {\n        \"project_id\": \"quasarpunk\",\n        \"name\": \"QuasarPunk\"\n      }\n    ]\n  }\n}",
